<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password - ClassConneX</title>
    <link rel="stylesheet" href="css/style.css">
    <style>
        .message {
            padding: 15px;
            margin: 20px 0;
            border-radius: 5px;
            font-size: 14px;
            text-align: center;
        }
        .message.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .message.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .back-link {
            text-align: center;
            margin-top: 15px;
        }
        .back-link a {
            color: #0b3c61;
            text-decoration: none;
            font-size: 14px;
        }
        .back-link a:hover {
            text-decoration: underline;
        }
        .info-text {
            font-size: 13px;
            color: #666;
            margin-top: 5px;
        }
    </style>
    {{#if redirectToLogin}}
    <script>
        setTimeout(function() {
            window.location.href = '/';
        }, 3000);
    </script>
    {{/if}}
</head>
<body>
    <h1 class="coll">ClassConneX</h1>
    <h2>Reset Your Password</h2>
    <div class="container">
        <div class="header">
            <h3>NEW PASSWORD</h3>
        </div>
        
        {{#if message}}
            <div class="message {{type}}">
                {{message}}
                {{#if redirectToLogin}}
                    <p class="info-text">Redirecting to login page...</p>
                {{/if}}
            </div>
        {{/if}}

        {{#unless redirectToLogin}}
        <form action="/reset-password" method="POST" class="form" id="form">
            <div class="form-control">
                <label for="email">Email Address</label>
                <input type="email" id="email" placeholder="Your email" autocomplete="off" name="email" value="{{email}}" required>
            </div>
            
            <div class="form-control">
                <label for="resetCode">Reset Code</label>
                <input type="text" id="resetCode" placeholder="Enter 6-digit code" autocomplete="off" name="resetCode" maxlength="6" required>
                <small>Enter the code you received</small>
            </div>

            <div class="form-control">
                <label for="newPassword">New Password</label>
                <input type="password" id="newPassword" placeholder="Enter new password" autocomplete="off" name="newPassword" required>
                <small>At least 6 characters</small>
            </div>

            <div class="form-control">
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" id="confirmPassword" placeholder="Confirm new password" autocomplete="off" name="confirmPassword" required>
            </div>

            <input type="submit" value="Reset Password" class="btn" name="">
        </form>
        {{/unless}}

        <div class="back-link">
            <a href="/">← Back to Login</a>
            {{#unless redirectToLogin}}
            <span> | </span>
            <a href="/forgot-password">Get New Code</a>
            {{/unless}}
        </div>
    </div>
</body>
</html>
