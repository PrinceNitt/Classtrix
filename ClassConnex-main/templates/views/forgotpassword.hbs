<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password - ClassConneX</title>
    <link rel="stylesheet" href="css/style.css">
    <style>
        .message {
            padding: 15px;
            margin: 20px 0;
            border-radius: 5px;
            font-size: 14px;
            text-align: center;
        }
        .message.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .message.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .reset-code {
            font-size: 24px;
            font-weight: bold;
            color: #0b3c61;
            padding: 10px;
            background: #f0f0f0;
            border-radius: 5px;
            margin: 10px 0;
        }
        .btn-secondary {
            background: linear-gradient(to right, #74ebd5, #9face6);
            color: #0b3c61;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 5px;
            display: inline-block;
            margin-top: 10px;
            font-weight: 600;
        }
        .btn-secondary:hover {
            opacity: 0.9;
        }
        .back-link {
            text-align: center;
            margin-top: 15px;
        }
        .back-link a {
            color: #0b3c61;
            text-decoration: none;
            font-size: 14px;
        }
        .back-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>
    <h1 class="coll">ClassConneX</h1>
    <h2>Forgot Password</h2>
    <div class="container">
        <div class="header">
            <h3>PASSWORD RESET</h3>
        </div>
        
        {{#if message}}
            <div class="message {{type}}">
                {{{message}}}
            </div>
        {{/if}}

        {{#unless showResetLink}}
        <form action="/forgot-password" method="POST" class="form" id="form">
            <div class="form-control">
                <label for="email">Email Address</label>
                <input type="email" id="email" placeholder="Enter your registered email" autocomplete="off" name="email" required>
                <small>Enter the email you used to register</small>
            </div>
            <input type="submit" value="Get Reset Code" class="btn" name="">
        </form>
        {{/unless}}

        {{#if showResetLink}}
            <div style="text-align: center; margin-top: 20px;">
                <a href="/reset-password?email={{email}}" class="btn">Enter Reset Code</a>
            </div>
        {{/if}}

        <div class="back-link">
            <a href="/">← Back to Login</a>
        </div>
    </div>
</body>
</html>
