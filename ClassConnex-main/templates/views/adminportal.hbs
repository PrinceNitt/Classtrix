<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ClassConneX</title>
    {{!-- <link rel="stylesheet" href="css/style.css" /> --}}
    <style>
@import url("https://fonts.googleapis.com/css2?family=Libre+Baskerville&family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Work+Sans:wght@400;500;600;700&display=swap");

* {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  font-family: "Work Sans", sans-serif;
}

html {
  font-size: 62.5%;
  /* 1rem = 10px */
  overflow-x: hidden;
}

body {
   background: url('css/bg1.jpg') no-repeat center center fixed;
  overflow-x: hidden;
}

.header {
  padding: 0 4.8rem;
  height: 10rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: rgb(40, 38, 38);
  box-shadow: rgba(0,0,0,0.05)  0px 8px 8px -6px;

}

body {
  background: radial-gradient(circle at 20% 20%, rgba(116,235,213,0.15), transparent 30%),
              radial-gradient(circle at 80% 0%, rgba(159,172,230,0.18), transparent 35%),
              linear-gradient(135deg, #0b1f36 0%, #0b3c61 45%, #0a2345 100%);
}

.page {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1.5rem 4rem;
}

.header .logo {
  height: 3rem;
  color: #e7f5ff;
 font-size: 20px;
}

.navbar-list {
  display: flex;
  gap: 4.8rem;
  list-style: none;
  
}

.navbar-link:link,
.navbar-link:visited {
  display: inline-block;
  text-transform: uppercase;
  text-decoration: none;
  font-size: 2rem;
  font-weight: 500;
  color:whitesmoke;
  transition: all 0.3s;
}


.navbar-link:active {
  color:black;
}

.mobile-navbar-btn {
  display: none;
  background: transparent;
  cursor: pointer;
  
}

.mobile-nav-icon {
  width: 4rem;
  height: 4rem;
  color:whitesmoke;
  
}

.mobile-nav-icon[name="close-outline"] {
  display: none;
}

/* ===========================================
Hero and Service Section Start
======================================= */
.section-hero,
.section-services {
  padding: 9.6rem 0;
  background-color: #0b3c61;
  height: 38vh;

  display: flex;
  justify-content: center;
  align-items: center;
   margin:37px;
    border-radius: 10px;
    margin-right: 62px;
    /* transform:translate(-50%,-50%); */
    background: linear-gradient(rgba(0,0,0,0.3),rgba(0,0,0,0.3));
    /* box-shadow: 0 2.8px 2.2px rgba(0,0,0,0.034),0 6.7px 5.3px rgba(0,0,0,0.048),0 12; */
    box-shadow: 7px 7px 60px purple;
}

.section-services {

}

.section-hero p,
.section-services p {
  font-size: 3.2rem;
  color: aliceblue;
}
.about{
  font-size: 43px;
}
.para{
  font-size: 22px;
}

/* ===========================================
Responsive Codes 
======================================= */

/* 980px  */
@media (max-width: 62em) {
  .mobile-navbar-btn {
    display: block;
    z-index: 999;
    color:whitesmoke;
  }

  .header {
    position: relative;
  }

  .header .logo {
    width: 40%;
  }

  .navbar {
    /* display: none; */
    width: 100%;
    height: 100vh;
    
    position: absolute;
    top: 0;
    left: 0;

    display: flex;
    justify-content: center;
    align-items: center;

    /* to get the tranisition  */
    transform: translateX(100%);
    transition: all 0.5s linear;
    background:linear-gradient(to left,#74ebd5,#9face6);

/*
background: linear-gradient(90deg,
    rgba(255, 222, 0, 0) 100%,
     rgba(255, 202, 2, 0.047) 95%,
      rgba(255, 172, 5, 0.145) 90%,
       rgba(255, 168, 5, 0.25) 85%,
         rgba(255, 150, 6, 0.35) 79%,  
          rgba(255, 145, 7, 0.45) 72%,
           rgba(255, 140, 7, 0.55) 64%,
             rgba(255, 125, 8, 0.65) 55%,
              rgba(255, 113, 9, 0.753) 47%,
              rgba(255, 103, 10, 0.855) 37%,
                rgba(255, 98, 11, 0.953) 27%, 
                 rgba(255, 91, 11, 0.973) 15%, 
                  rgb(255, 89, 11) 0%);   */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .navbar-list {
    flex-direction: column;
    align-items: center;
    color: #e7f5ff;
  }

  .active .navbar {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    

  }
  .active .navbar-link{
    color:black;
  }

  .active .mobile-navbar-btn .mobile-nav-icon[name="close-outline"] {
    display: block;
  }

  .active .mobile-navbar-btn .mobile-nav-icon[name="menu-outline"] {
    display: none;
  }
}

/* Below 560px  */
@media (max-width: 35em) {
  .header {
    padding: 0 2.4rem;
  }

  .header .logo {
    width: 60%;
  }
}

/* Admin login block */
.section-login {
  padding: 4rem 0;
  display: flex;
  justify-content: center;
}
.login-card {
  width: 90%;
  max-width: 1000px;
  background: linear-gradient(145deg, rgba(22,36,55,0.9), rgba(15,26,42,0.92));
  color: #e7f5ff;
  padding: 3rem;
  border-radius: 10px;
  box-shadow: 0 12px 45px rgba(0,0,0,0.45);
  display: flex;
  flex-direction: column;
  gap: 1.6rem;
}
.login-card h2 {
  font-size: 2.4rem;
  text-align: center;
  margin-bottom: 1rem;
}
.login-card label {
  font-size: 1.4rem;
  margin-bottom: 0.4rem;
  color: #e7f5ff;
}
.login-card input {
  width: 100%;
  padding: 1rem;
  border-radius: 6px;
  border: 1px solid #9face6;
  background: #1e2a38;
  color: #e7f5ff;
}
.login-card button {
  margin-top: 1.2rem;
  padding: 1rem;
  width: 100%;
  border: none;
  border-radius: 6px;
  background: linear-gradient(to right,#74ebd5,#9face6);
  color: #0b3c61;
  font-size: 1.6rem;
  font-weight: 600;
  cursor: pointer;
}

.pill {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.6rem 1.2rem;
  border-radius: 999px;
  background: rgba(116,235,213,0.15);
  color: #9ee7d8;
  font-weight: 600;
  font-size: 1.4rem;
  border: 1px solid rgba(158, 245, 235, 0.35);
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.5rem;
  margin: 2rem 0;
}
.card {
  background: linear-gradient(160deg, rgba(116,235,213,0.12), rgba(159,172,230,0.12));
  border: 1px solid rgba(158, 245, 235, 0.2);
  border-radius: 12px;
  padding: 1.6rem;
  color: #e7f5ff;
  box-shadow: 0 10px 30px rgba(0,0,0,0.25);
}
.card h3 {
  margin: 0 0 0.4rem 0;
  font-size: 1.5rem;
  letter-spacing: 0.02em;
}
.card .big {
  font-size: 2.6rem;
  font-weight: 700;
}

.table-wrap {
  overflow: auto;
  max-height: 360px;
  border: 1px solid rgba(158, 245, 235, 0.25);
  border-radius: 10px;
}
table {
  width: 100%;
  border-collapse: collapse;
  color: #e7f5ff;
}
thead tr {
  background: rgba(116,235,213,0.12);
}
th, td {
  padding: 10px 12px;
  text-align: left;
  border-bottom: 1px solid rgba(158, 245, 235, 0.15);
}
tbody tr:hover {
  background: rgba(255,255,255,0.04);
}

.section-block {
  margin: 2rem 0;
}
    </style>
  </head>
  <body>
    <header class="header">
        <h1 class="logo">ClassConneX</h1>
      

      <nav class="navbar">
        <ul class="navbar-list">
          <li><a class="navbar-link" href="/home">Home</a></li>
          <li><a class="navbar-link" href="/assingment">Assingment</a></li>
          <li><a class="navbar-link" href="/addstu">Add-stu</a></li>
          <li><a class="navbar-link" href="/upload">TimeTable</a></li>
          <li><a class="navbar-link" href="/notice">notice</a></li>
           <li><a class="navbar-link" href="/club">club</a></li>     
          {{#if useremail.cr}}
              <li><a class="navbar-link" href="/adminportal">adminportal</a></li>
              <li><a class="navbar-link" href="/logout">logout</a></li>
              {{/if}}
        </ul>
      </nav>

      <div class="mobile-navbar-btn">
        <ion-icon name="menu-outline" class="mobile-nav-icon"></ion-icon>
        <ion-icon name="close-outline" class="mobile-nav-icon"></ion-icon>
      </div>
    </header>

    <!-- ======================================== 
          Our Main Hero Section Start  
    ========================================  -->
    <main class="page">
      <section class="section-hero">
        <div class="hero">
          <h1 class="about">Admin Dashboard</h1>
          <h1 class="para">Welcome, {{useremail.username}}. Review users and assignments below.</h1>
          <div class="pill">Authorized Admin</div>
        </div>
      </section>

    <!-- ======================================== 
          Our Service Section Start  
    ========================================  -->
    <section class="section-block">
      <div class="cards">
        <div class="card">
          <h3>Total Users</h3>
          <div class="big">{{userCount}}</div>
        </div>
        <div class="card">
          <h3>Total Assignments</h3>
          <div class="big">{{tasksCount}}</div>
        </div>
      </div>
    </section>

    <section class="section-login">
      <div class="login-card">
        <h2 style="text-align:left;">User List</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Username</th>
                <th>Email</th>
                <th>Dept</th>
                <th>CR</th>
              </tr>
            </thead>
            <tbody>
              {{#each users}}
              <tr>
                <td>{{username}}</td>
                <td>{{email}}</td>
                <td>{{dept}}</td>
                <td>{{cr}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-login">
      <div class="login-card">
        <h2 style="text-align:left;">Assignments</h2>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Description</th>
                <th>Subject</th>
                <th>Due</th>
              </tr>
            </thead>
            <tbody>
              {{#each tasks}}
              <tr>
                <td>{{description}}</td>
                <td>{{subject}}</td>
                <td>{{date}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ======================================== 
          Our JavaScript Section Start  
    ========================================  -->
    <script
      type="module"
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.esm.js"
    ></script>
    <script
      nomodule
      src="https://unpkg.com/ionicons@5.5.2/dist/ionicons/ionicons.js"
    ></script>
    <script>const mobile_nav = document.querySelector(".mobile-navbar-btn");
const nav_header = document.querySelector(".header");

const toggleNavbar = () => {
  // alert("Plz Subscribe ");
  nav_header.classList.toggle("active");
};

mobile_nav.addEventListener("click", () => toggleNavbar());</script>
  </body>
</html>